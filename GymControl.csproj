<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>235ab34f-c55e-475e-9b5f-50672e577a8a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

<ItemGroup>
  <!-- Evitar que el proyecto principal compile los archivos xUnit -->
  <Compile Remove="GymControl.Tests/**/*.cs" />
  <Content Remove="GymControl.Tests/**" />
  <EmbeddedResource Remove="GymControl.Tests/**" />
  <None Remove="GymControl.Tests/**" />
</ItemGroup>

</Project>
