
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - GymControl</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/GymControl.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm
                    navbar-toggleable-sm navbar-light
                    bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- Nombre del sistema -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    GymControl
                </a>

                <!-- Botón para menú en celulares -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Mostrar menú">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse
                            d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <!-- INICIO -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        <!-- CLIENTES -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Cliente"
                               asp-action="Index">
                                Clientes
                            </a>
                        </li>

                        <!-- MEMBRESÍAS -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Membresia"
                               asp-action="Index">
                                Membresías
                            </a>
                        </li>

                        <!-- PAGOS -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Pago"
                               asp-action="Index">
                                Pagos
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- CONTENIDO DE CADA PÁGINA -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- PIE DE PÁGINA -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GymControl -
            Sistema de Gestión de Gimnasio
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
