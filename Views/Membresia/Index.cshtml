
@model List<GymControl.Models.Membresia>

@{
    ViewData["Title"] = "Membresías";
}

<h2>Gestión de Membresías</h2>

<p>Lista de membresías registradas en GymControl.</p>

<a href="@Url.Action("Create", "Membresia")"
   class="btn btn-primary mb-3">
    + Nueva Membresía
</a>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="table-responsive">

    <table class="table table-bordered table-striped">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Tipo</th>
                <th>Precio (Bs)</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var membresia in Model)
            {
                <tr>
                    <td>@membresia.Id</td>

                    <td>@membresia.NombreCliente</td>

                    <td>@membresia.Tipo</td>

                    <td>@membresia.Precio.ToString("N2")</td>

                    <td>@membresia.FechaInicio.ToString("dd/MM/yyyy")</td>

                    <td>@membresia.FechaFin.ToString("dd/MM/yyyy")</td>

                    <td>
                        @if (membresia.Estado == "Activa")
                        {
                            <span class="badge bg-success">
                                Activa
                            </span>
                        }
                        else if (membresia.Estado == "Vencida")
                        {
                            <span class="badge bg-danger">
                                Vencida
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @membresia.Estado
                            </span>
                        }
                    </td>

                    <td>
                        <div class="d-flex gap-2">

                            <a href="@Url.Action("Edit", "Membresia", new { id = membresia.Id })"
                               class="btn btn-warning btn-sm">
                                Editar
                            </a>

                            <a href="@Url.Action("Delete", "Membresia", new { id = membresia.Id })"
                               class="btn btn-danger btn-sm">
                                Eliminar
                            </a>

                        </div>
                    </td>
                </tr>
            }
        </tbody>

    </table>

</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Todavía no existen membresías registradas.
    </div>
}
