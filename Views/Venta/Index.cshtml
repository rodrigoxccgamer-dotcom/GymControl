
@model List<GymControl.Models.Venta>

@{
    ViewData["Title"] = "Historial de Ventas";
}

<div class="container mt-4">

    <h2>Historial de Ventas</h2>

    <p>Consulta las ventas registradas en GymControl.</p>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <a asp-controller="Venta"
       asp-action="Create"
       class="btn btn-primary mb-3">
        + Nueva Venta
    </a>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead class="table-dark">
                <tr>
                    <th>N.º Venta</th>
                    <th>Cliente</th>
                    <th>Vendedor</th>
                    <th>Fecha</th>
                    <th>Total bruto (Bs)</th>
                    <th>Descuento (%)</th>
                    <th>Monto descontado (Bs)</th>
                    <th>Total final (Bs)</th>
                    <th>Estado</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var venta in Model)
                {
                    var totalFinalMostrar = venta.TotalFinal > 0
                        ? venta.TotalFinal
                        : venta.Total - venta.MontoDescuento;

                    <tr>
                        <td>@venta.Id</td>

                        <td>@venta.NombreCliente</td>

                        <td>@venta.Vendedor</td>

                        <td>
                            @venta.FechaVenta.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @venta.Total.ToString("N2")
                        </td>

                        <td>
                            @venta.PorcentajeDescuento.ToString("0.##")%
                        </td>

                        <td>
                            @venta.MontoDescuento.ToString("N2")
                        </td>

                        <td class="fw-bold text-success">
                            @totalFinalMostrar.ToString("N2")
                        </td>

                        <td>
                            @if (venta.Estado == "Confirmada")
                            {
                                <span class="badge bg-success">
                                    Confirmada
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @venta.Estado
                                </span>
                            }
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Todavía no existen ventas registradas.
        </div>
    }

</div>
