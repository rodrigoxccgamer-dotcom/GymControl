
@model List<GymControl.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<h2>Gestión de Clientes</h2>

<p>Lista de clientes registrados en GymControl.</p>


<a asp-controller="Cliente"
   asp-action="Create"
   class="btn btn-primary mb-3">
    + Nuevo Cliente
</a>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

    </div>
}


<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombres</th>
            <th>Apellidos</th>
            <th>CI</th>
            <th>Teléfono</th>
            <th>Correo</th>
            <th>Fecha de Registro</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var cliente in Model)
        {
            <tr>
                <td>@cliente.Id</td>
                <td>@cliente.Nombres</td>
                <td>@cliente.Apellidos</td>
                <td>@cliente.CI</td>
                <td>@cliente.Telefono</td>
                <td>@cliente.Correo</td>
                <td>@cliente.FechaRegistro.ToString("dd/MM/yyyy")</td>


<td>
    <a asp-controller="Cliente"
       asp-action="Edit"
       asp-route-id="@cliente.Id"
       class="btn btn-warning btn-sm">
        Editar
    </a>

    <a asp-controller="Cliente"
       asp-action="Delete"
       asp-route-id="@cliente.Id"
       class="btn btn-danger btn-sm">
        Eliminar
    </a>
</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Todavía no existen clientes registrados.
    </div>
}
