
@model List<GymControl.Models.Pago>

@{
    ViewData["Title"] = "Pagos";
}

<h2>Gestión de Pagos</h2>

<p>Lista de pagos registrados en GymControl.</p>

<a href="@Url.Action("Create", "Pago")"
   class="btn btn-primary mb-3">
    + Nuevo Pago
</a>


@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="table-responsive">

    <table class="table table-bordered table-striped">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Membresía</th>
                <th>Monto (Bs)</th>
                <th>Fecha de Pago</th>
                <th>Método de Pago</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var pago in Model)
            {
                <tr>
                    <td>@pago.Id</td>

                    <td>@pago.NombreCliente</td>

                    <td>@pago.TipoMembresia</td>

                    <td>@pago.Monto.ToString("N2")</td>

                    <td>
                        @pago.FechaPago.ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        @pago.MetodoPago
                    </td>

<td>
    <div class="d-flex gap-2">

        <a href="@Url.Action("Edit", "Pago", new { id = pago.Id })"
           class="btn btn-warning btn-sm">
            Editar
        </a>

        <a href="@Url.Action("Delete", "Pago", new { id = pago.Id })"
           class="btn btn-danger btn-sm">
            Eliminar
        </a>

    </div>
</td>

                </tr>
            }
        </tbody>

    </table>

</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Todavía no existen pagos registrados.
    </div>
}
