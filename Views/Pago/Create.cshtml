
@model GymControl.Models.Pago

@{
    ViewData["Title"] = "Registrar Pago";
}

<h2>Registrar Nuevo Pago</h2>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-controller="Pago"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="MembresiaId"
                       class="form-label">
                    Membresía
                </label>

                <select asp-for="MembresiaId"
                        asp-items="ViewBag.Membresias"
                        class="form-select">

                    <option value="0">
                        Seleccione una membresía
                    </option>

                </select>

                <span asp-validation-for="MembresiaId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Monto"
                       class="form-label">
                    Monto (Bs)
                </label>

                <input asp-for="Monto"
                       type="number"
                       step="0.01"
                       min="0.01"
                       class="form-control" />

                <span asp-validation-for="Monto"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaPago"
                       class="form-label">
                    Fecha del Pago
                </label>

                <input asp-for="FechaPago"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="FechaPago"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MetodoPago"
                       class="form-label">
                    Método de Pago
                </label>

                <select asp-for="MetodoPago"
                        class="form-select">

                    <option value="">
                        Seleccione un método
                    </option>

                    <option value="Efectivo">
                        Efectivo
                    </option>

                    <option value="Transferencia">
                        Transferencia
                    </option>

                    <option value="Tarjeta">
                        Tarjeta
                    </option>

                </select>

                <span asp-validation-for="MetodoPago"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-success">
                Guardar Pago
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
